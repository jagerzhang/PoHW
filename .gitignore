# Build outputs (never commit binaries / intermediate dirs)
/.build/
/dist/
*.apk
*.ap_
*.dex
*.class
gen/
classes/
dexout/
out/
*.old.*
sources.txt
classes.txt

# Debug signing key is generated locally by app/build.sh
*.keystore
*.jks

# Donation / branding working files (only the cropped PNGs and generator ship)
/.donate_src/
/.branding_preview.png

# Python
__pycache__/
*.py[cod]
.venv/

# Local data snapshots are not committed to the repository
/data/
/third_party/

# OS / editors
.DS_Store
.idea/
.vscode/
*.iml

# v1.2.5: Makers 站点需要随仓库分发最新版安装包（只放 site/dl/，不放历史包）
!site/dl/*.apk
