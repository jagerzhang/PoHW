<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.jager.tvquiz"
    android:versionCode="55"
    android:versionName="1.3.6">

    <uses-sdk android:minSdkVersion="14" android:targetSdkVersion="33" />

    <!-- 跨应用全屏答题遮罩 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 常驻前台服务（Android 8+ 必须） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 13+ 前台服务通知可见性，MainActivity 会运行时申请 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 可选在线题库源：默认不启用，只有家长自行配置地址后才会发起请求 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- v1.3.0 未发布：休眠唤醒兜底与常驻自检 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- v1.2.5 在线版本更新：Android 8+ 拉起系统安装界面必需 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- TV 无触摸屏；不强制 Leanback，手机/平板亦可安装 -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.type.television" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <!-- 厂商自启动设置页是显式 ComponentName 跳转，声明可见性以兼容 Android 11+ -->
    <queries>
        <package android:name="com.miui.securitycenter" />
        <package android:name="com.coloros.safecenter" />
        <package android:name="com.oppo.safe" />
        <package android:name="com.huawei.systemmanager" />
        <package android:name="com.vivo.permissionmanager" />
        <package android:name="com.hisense.tvsettings" />
        <package android:name="com.tcl.settings" />
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher"
        android:banner="@drawable/tv_banner"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@android:style/Theme.Holo.Light.NoActionBar">

        <!-- 把已校验的 APK 以 content:// 交给系统安装器；不导出、只读。 -->
        <provider
            android:name=".UpdateProvider"
            android:authorities="com.jager.tvquiz.update"
            android:exported="false"
            android:grantUriPermissions="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize" />

        <activity
            android:name=".PairActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize" />

        <activity
            android:name=".WrongBookActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize" />

        <activity
            android:name=".PracticeActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize" />

        <activity
            android:name=".DonateActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize" />

        <service
            android:name=".QuizOverlayService"
            android:exported="false"
            android:enabled="true"
            android:stopWithTask="false" />

        <!-- 仅 BOOT_COMPLETED 受 RECEIVE_BOOT_COMPLETED 保护，且是 Android 12+
             后台启动前台服务的豁免广播；QUICKBOOT 拆到单独 receiver。 -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true"
            android:permission="android.permission.RECEIVE_BOOT_COMPLETED">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".QuickBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.tcl.android.intent.action.BOOT_COMPLETED" />
                <action android:name="com.hisense.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- 休眠唤醒 / 解锁 / 覆盖安装 / 定时自检：不带 RECEIVE_BOOT_COMPLETED
             permission，否则非保护广播会被系统过滤。SCREEN_ON 标准上只能动态注册，
             此处声明仅为兼容部分厂商；主力是 USER_PRESENT + AlarmManager。 -->
        <receiver
            android:name=".ReviveReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.USER_PRESENT" />
                <action android:name="android.intent.action.SCREEN_ON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.net.conn.CONNECTIVITY_CHANGE" />
                <action android:name="com.jager.tvquiz.REVIVE" />
            </intent-filter>
        </receiver>

        <!-- 可选常驻看门狗：默认不启用，家长须到系统无障碍设置中手动开启。 -->
        <service
            android:name=".GuardAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/guard_accessibility" />
        </service>
    </application>
</manifest>
