  "questions": [
    {
      "topic": "两位数进位加法",
      "text": "小明有 36 张卡片，又买来 27 张，一共有多少张？",
      "options": ["53 张", "63 张", "62 张", "73 张"],
      "answerIndex": 1,
      "explain": "36 + 27：个位 6 + 7 = 13，向十位进 1；十位 3 + 2 + 1 = 6，一共 63 张。"
    },
    {
      "topic": "长方形周长",
      "text": "一个长方形长 8 厘米、宽 5 厘米，它的周长是多少？",
      "options": ["13 厘米", "26 厘米", "40 厘米", "80 厘米"],
      "answerIndex": 1,
      "explain": "周长 =（长 + 宽）× 2 =（8 + 5）× 2 = 26 厘米。40 平方厘米是面积，别混了。"
    },
    {
      "topic": "表内除法",
      "text": "把 72 个苹果平均装进 8 个篮子，每个篮子装几个？",
      "options": ["7 个", "8 个", "9 个", "10 个"],
      "answerIndex": 2,
      "explain": "平均分用除法：72 ÷ 8 = 9，因为 8 × 9 = 72。"
    }
  ]
}
